# Supabase — Production Database (Session Mode Pooler — IPv4)
# Project: https://qpfcclrftybsczycedve.supabase.co
# Copy this file to .env.supabase and fill in the actual values

SPRING_DATASOURCE_URL=jdbc:postgresql://aws-1-ap-south-1.pooler.supabase.com:5432/postgres
SPRING_DATASOURCE_USERNAME=postgres.qpfcclrftybsczycedve
SPRING_DATASOURCE_PASSWORD=<ask team lead>

# Email (Gmail SMTP — OTP)
MAIL_USERNAME="<gmail>"
MAIL_PASSWORD="<gmail app password>"

# JWT
JWT_SECRET=your-256-bit-secret-key-change-this-in-production

# Cookie (production should set to true if using HTTPS)
COOKIE_SECURE=false

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Flyway — required because Supabase schema 'public' is non-empty
SPRING_FLYWAY_BASELINE_ON_MIGRATE=true
SPRING_FLYWAY_BASELINE_VERSION=0
