# Environment Configuration Template
# Copy this file to .env for environment configuration

# Supabase - Production Database
SPRING_DATASOURCE_URL=jdbc:postgresql://aws-1-ap-south-1.pooler.supabase.com:5432/postgres
SPRING_DATASOURCE_USERNAME=postgres.qpfcclrftybsczycedve
SPRING_DATASOURCE_PASSWORD=your_supabase_password_here

# Email (Gmail SMTP - OTP)
MAIL_USERNAME=your_gmail_username_here@gmail.com
MAIL_PASSWORD=your_gmail_app_password_here

# JWT Security Secret
JWT_SECRET=your-256-bit-secret-key-change-this-in-production

# Cookie Configuration (Set true in production HTTPS)
COOKIE_SECURE=false

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Flyway Baseline Configuration
SPRING_FLYWAY_BASELINE_ON_MIGRATE=true
SPRING_FLYWAY_BASELINE_VERSION=0

# Gemini AI Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite

